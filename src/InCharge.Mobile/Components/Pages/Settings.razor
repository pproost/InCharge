@page "/settings"
@using InCharge.Mobile.Services
@inject NotificationService Notifier
@inject AppSettingsService AppSettings
@inject ActivityLogService LogService
@inject ActivityTypeService TypeService
@inject CoachSyncService CoachSync
@implements IDisposable

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<section class="settings-section">
    <h2 class="section-title">Notifications</h2>
    <div class="settings-card">
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-name">Permission</div>
                <div class="setting-hint @(notificationsEnabled ? "text-success" : "text-danger")">
                    @(notificationsEnabled ? "Enabled" : "Disabled")
                </div>
            </div>
            @if (!notificationsEnabled)
            {
                <button class="btn btn-primary btn-sm" @onclick="RequestPermission">Enable</button>
            }
            else
            {
                <button class="btn btn-outline-success btn-sm" @onclick="SendTestNotification">Send test</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="setting-hint px-3 pb-2">@message</div>
        }
        <label class="setting-row" for="onlyLatest">
            <div class="setting-text">
                <div class="setting-name">Only show the latest notification</div>
                <div class="setting-hint">Each new cue replaces the previous one instead of stacking up.</div>
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="onlyLatest"
                       checked="@settings.OnlyLatestNotification"
                       @onchange="e => Update(s => s.OnlyLatestNotification = (bool)(e.Value ?? false))" />
            </div>
        </label>
    </div>
    <p class="section-footnote">
        Cues reach a paired watch (e.g. a Fitbit) through these notifications. If enabling doesn't work,
        allow them via Android Settings &rarr; Apps &rarr; InCharge &rarr; Notifications.
    </p>
</section>

<section class="settings-section">
    <h2 class="section-title">Activity</h2>
    <div class="settings-card">
        <label class="setting-row" for="showDuration">
            <div class="setting-text">
                <div class="setting-name">Show total duration when finished</div>
                <div class="setting-hint">When off, the completion screen shows no time at all.</div>
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="showDuration"
                       checked="@settings.ShowDurationOnComplete"
                       @onchange="e => Update(s => s.ShowDurationOnComplete = (bool)(e.Value ?? false))" />
            </div>
        </label>
        <label class="setting-row" for="autoSave">
            <div class="setting-text">
                <div class="setting-name">Save finished activities automatically</div>
                <div class="setting-hint">When off, use "Save to log" on the completion screen.</div>
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="autoSave"
                       checked="@settings.AutoSaveToLog"
                       @onchange="e => Update(s => s.AutoSaveToLog = (bool)(e.Value ?? false))" />
            </div>
        </label>
    </div>
</section>

<section class="settings-section">
    <h2 class="section-title">Activity types</h2>
    <div class="settings-card">
        @foreach (var type in types)
        {
            <div class="setting-row type-row">
                <select class="form-select icon-select" value="@type.Icon" @onchange="e => UpdateType(type, t => t.Icon = e.Value?.ToString() ?? t.Icon)" aria-label="Icon">
                    @foreach (var icon in ActivityTypeService.IconsIncluding(type.Icon))
                    {
                        <option value="@icon">@icon</option>
                    }
                </select>
                <input class="form-control" value="@type.Name" aria-label="Name"
                       @onchange="e => UpdateType(type, t => t.Name = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? t.Name : e.Value!.ToString()!.Trim())" />
                @if (pendingDeleteTypeId == type.Id)
                {
                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteType(type)">Delete?</button>
                }
                else
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => pendingDeleteTypeId = type.Id" title="Delete" aria-label="Delete">✕</button>
                }
            </div>
        }
        <div class="setting-row type-row">
            <select class="form-select icon-select" @bind="newTypeIcon" aria-label="Icon for new type">
                @foreach (var icon in ActivityTypeService.Icons)
                {
                    <option value="@icon">@icon</option>
                }
            </select>
            <input class="form-control" placeholder="New type, e.g. Rowing" @bind="newTypeName" @bind:event="oninput" aria-label="New type name" />
            <button class="btn btn-primary btn-sm" @onclick="AddType" disabled="@string.IsNullOrWhiteSpace(newTypeName)">Add</button>
        </div>
    </div>
    <p class="section-footnote">
        Pick a type on the completion screen, or set a default per Advanced session. Deleting a type
        keeps the logged activities; they just show up without a type.
    </p>
</section>

<section class="settings-section">
    <h2 class="section-title">Coach sync</h2>
    <div class="settings-card">
        <label class="setting-row" for="coachSync">
            <div class="setting-text">
                <div class="setting-name">Sync with HealthCoach</div>
                <div class="setting-hint">Uploads every activity you log or change and brings in sessions planned by your coach. Works offline; it catches up later.</div>
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="coachSync"
                       checked="@CoachSync.State.Enabled"
                       @onchange="e => CoachSync.SetEnabled((bool)(e.Value ?? false))" />
            </div>
        </label>
        @if (CoachSync.State.Enabled)
        {
            <div class="setting-row setting-stack">
                <div class="setting-name">Server URL</div>
                <input class="form-control" type="url" inputmode="url" autocapitalize="off" spellcheck="false"
                       placeholder="https://….azurewebsites.net" value="@CoachSync.State.ServerUrl"
                       @onchange="e => CoachSync.SetServerUrl(e.Value?.ToString() ?? string.Empty)" aria-label="Server URL" />
            </div>
            <div class="setting-row setting-stack">
                <div class="setting-name">Device token</div>
                @if (hasToken && !editingToken)
                {
                    <div class="token-row">
                        <span class="setting-hint">🔒 Stored securely on this device</span>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => editingToken = true">Change</button>
                    </div>
                }
                else
                {
                    <div class="token-row">
                        <input class="form-control" type="password" autocomplete="off" autocapitalize="off" spellcheck="false"
                               placeholder="Paste the InCharge token" @bind="tokenInput" @bind:event="oninput" aria-label="Device token" />
                        <button class="btn btn-primary btn-sm" @onclick="SaveToken" disabled="@string.IsNullOrWhiteSpace(tokenInput)">Save</button>
                    </div>
                    @if (hasToken)
                    {
                        <div class="token-row">
                            <button class="btn btn-link btn-sm p-0" @onclick="CancelTokenEdit">Cancel</button>
                            <button class="btn btn-link btn-sm p-0 text-danger" @onclick="RemoveToken">Remove token</button>
                        </div>
                    }
                }
            </div>
            <div class="setting-row">
                <div class="setting-text">
                    <div class="setting-name">Status</div>
                    <div class="setting-hint @(SyncHasProblem ? "text-danger" : "")">@SyncStatus</div>
                </div>
                <div class="sync-buttons">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="TestConnection" disabled="@testing">Test</button>
                    <button class="btn btn-outline-primary btn-sm" @onclick="SyncNow" disabled="@CoachSync.IsSyncing">Sync now</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(testMessage))
            {
                <div class="setting-hint px-3 pb-2">@testMessage</div>
            }
            @if (hasToken && LogService.LoadAll().Count > 0)
            {
                <div class="setting-row">
                    <div class="setting-text">
                        <div class="setting-name">History</div>
                        <div class="setting-hint">
                            @if (CoachSync.State.HistoryQueuedAt is { } queuedAt)
                            {
                                @($"Sent for upload {FormatWhen(queuedAt)}. The status above shows what is still waiting.")
                            }
                            else
                            {
                                @("Activities from before sync was on aren't on the server yet. Send them once.")
                            }
                        </div>
                    </div>
                    @if (CoachSync.State.HistoryQueuedAt is null)
                    {
                        <button class="btn btn-outline-primary btn-sm" @onclick="UploadHistory">Upload @LogService.LoadAll().Count</button>
                    }
                    else
                    {
                        <span class="setting-hint text-success">✓</span>
                    }
                </div>
            }
        }
    </div>
    <p class="section-footnote">
        Activities logged or changed while sync is on are uploaded automatically; older ones go up once via
        History. Deleting one from the log also removes it on the server.
    </p>
</section>

<section class="settings-section">
    <h2 class="section-title">Data</h2>
    <div class="settings-card">
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-name">Activity log</div>
                <div class="setting-hint">@LogService.LoadAll().Count session(s) stored on this device</div>
            </div>
            <a class="btn btn-outline-primary btn-sm" href="log">Open</a>
        </div>
    </div>
</section>

@code {
    private AppSettings settings = new();
    private bool notificationsEnabled;
    private string? message;
    private int sendCount;
    private List<ActivityType> types = new();
    private string newTypeName = "";
    private string newTypeIcon = ActivityTypeService.Icons[0];
    private string? pendingDeleteTypeId;
    private bool hasToken;
    private bool editingToken;
    private string tokenInput = string.Empty;
    private bool testing;
    private string? testMessage;

    private bool SyncHasProblem => CoachSync.State.AuthFailed || !string.IsNullOrEmpty(CoachSync.State.LastError);

    private string SyncStatus
    {
        get
        {
            var state = CoachSync.State;
            if (string.IsNullOrEmpty(state.ServerUrl) || !hasToken)
            {
                return "Enter the server URL and device token.";
            }
            if (state.AuthFailed)
            {
                return "Token rejected. Check the token, then save it again.";
            }
            if (CoachSync.IsSyncing)
            {
                return "Uploading…";
            }

            var waiting = CoachSync.PendingCount == 0 ? "nothing waiting" : $"{CoachSync.PendingCount} waiting";
            if (!string.IsNullOrEmpty(state.LastError))
            {
                return $"{state.LastError} ({waiting})";
            }
            var plans = state.LastImportedAt is { } importedAt
                ? $" · {state.LastImportedCount} new plan(s) {FormatWhen(importedAt)}"
                : "";
            return state.LastSyncAt is { } last
                ? $"Last sync {FormatWhen(last)} · {waiting}{plans}"
                : $"Not synced yet · {waiting}";
        }
    }

    private static string FormatWhen(DateTimeOffset when) =>
        when.LocalDateTime.Date == DateTime.Today
            ? $"today {when.LocalDateTime:HH:mm}"
            : when.LocalDateTime.ToString("d MMM HH:mm");

    private async Task SaveToken()
    {
        await CoachSync.SetTokenAsync(tokenInput);
        tokenInput = string.Empty;
        editingToken = false;
        hasToken = await CoachSync.HasTokenAsync();
    }

    private void CancelTokenEdit()
    {
        editingToken = false;
        tokenInput = string.Empty;
    }

    private async Task RemoveToken()
    {
        await CoachSync.SetTokenAsync(null);
        editingToken = false;
        hasToken = false;
    }

    private async Task TestConnection()
    {
        testing = true;
        testMessage = "Testing…";
        var result = await CoachSync.TestConnectionAsync();
        testMessage = result switch
        {
            ConnectionCheck.Ok => $"✓ Connected ({DateTime.Now:HH:mm:ss})",
            ConnectionCheck.NotConfigured => "Enter a valid URL and token first.",
            ConnectionCheck.Unauthorized => "The server rejected the token.",
            ConnectionCheck.Unreachable => "Server not reachable. Check the URL and your connection.",
            _ => "The server answered with an error."
        };
        testing = false;
    }

    private Task SyncNow() => CoachSync.SyncAsync();

    private void UploadHistory() => CoachSync.QueueHistory();

    private void OnSyncStatusChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CoachSync.StatusChanged -= OnSyncStatusChanged;

    private void UpdateType(ActivityType type, Action<ActivityType> change)
    {
        var before = (type.Name, type.Icon);
        change(type);
        TypeService.SaveAll(types);
        if (before != (type.Name, type.Icon))
        {
            LogService.TouchType(type.Id);
        }
    }

    private void AddType()
    {
        if (string.IsNullOrWhiteSpace(newTypeName))
        {
            return;
        }
        types.Add(new ActivityType { Name = newTypeName.Trim(), Icon = newTypeIcon });
        TypeService.SaveAll(types);
        newTypeName = "";
    }

    private void DeleteType(ActivityType type)
    {
        types.Remove(type);
        TypeService.SaveAll(types);
        LogService.TouchType(type.Id);
        pendingDeleteTypeId = null;
    }

    protected override async Task OnInitializedAsync()
    {
        settings = AppSettings.Load();
        types = TypeService.LoadAll();
        notificationsEnabled = await Notifier.AreNotificationsEnabledAsync();
        hasToken = await CoachSync.HasTokenAsync();
        CoachSync.StatusChanged += OnSyncStatusChanged;
    }

    private void Update(Action<AppSettings> change)
    {
        change(settings);
        AppSettings.Save(settings);
    }

    private async Task RequestPermission()
    {
        notificationsEnabled = await Notifier.RequestPermissionAsync();
    }

    private async Task SendTestNotification()
    {
        sendCount++;
        await Notifier.NotifyAsync("InCharge", $"Test notification #{sendCount} at {DateTime.Now:HH:mm:ss}");
        message = $"Test #{sendCount} sent at {DateTime.Now:HH:mm:ss}";
    }
}
