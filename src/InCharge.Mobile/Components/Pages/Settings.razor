@page "/settings"
@using InCharge.Mobile.Services
@inject NotificationService Notifier
@inject AppSettingsService AppSettings
@inject ActivityLogService LogService

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<section class="settings-section">
    <h2 class="section-title">Notifications</h2>
    <div class="settings-card">
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-name">Permission</div>
                <div class="setting-hint @(notificationsEnabled ? "text-success" : "text-danger")">
                    @(notificationsEnabled ? "Enabled" : "Disabled")
                </div>
            </div>
            @if (!notificationsEnabled)
            {
                <button class="btn btn-primary btn-sm" @onclick="RequestPermission">Enable</button>
            }
            else
            {
                <button class="btn btn-outline-success btn-sm" @onclick="SendTestNotification">Send test</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="setting-hint px-3 pb-2">@message</div>
        }
        <label class="setting-row" for="onlyLatest">
            <div class="setting-text">
                <div class="setting-name">Only show the latest notification</div>
                <div class="setting-hint">Each new cue replaces the previous one instead of stacking up.</div>
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="onlyLatest"
                       checked="@settings.OnlyLatestNotification"
                       @onchange="e => Update(s => s.OnlyLatestNotification = (bool)(e.Value ?? false))" />
            </div>
        </label>
    </div>
    <p class="section-footnote">
        Cues reach a paired watch (e.g. a Fitbit) through these notifications. If enabling doesn't work,
        allow them via Android Settings &rarr; Apps &rarr; InCharge &rarr; Notifications.
    </p>
</section>

<section class="settings-section">
    <h2 class="section-title">Activity</h2>
    <div class="settings-card">
        <label class="setting-row" for="showDuration">
            <div class="setting-text">
                <div class="setting-name">Show total duration when finished</div>
                <div class="setting-hint">When off, the completion screen shows no time at all.</div>
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="showDuration"
                       checked="@settings.ShowDurationOnComplete"
                       @onchange="e => Update(s => s.ShowDurationOnComplete = (bool)(e.Value ?? false))" />
            </div>
        </label>
        <label class="setting-row" for="autoSave">
            <div class="setting-text">
                <div class="setting-name">Save finished activities automatically</div>
                <div class="setting-hint">When off, use "Save to log" on the completion screen.</div>
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="autoSave"
                       checked="@settings.AutoSaveToLog"
                       @onchange="e => Update(s => s.AutoSaveToLog = (bool)(e.Value ?? false))" />
            </div>
        </label>
    </div>
</section>

<section class="settings-section">
    <h2 class="section-title">Data</h2>
    <div class="settings-card">
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-name">Activity log</div>
                <div class="setting-hint">@LogService.LoadAll().Count session(s) stored on this device</div>
            </div>
            <a class="btn btn-outline-primary btn-sm" href="log">Open</a>
        </div>
    </div>
</section>

@code {
    private AppSettings settings = new();
    private bool notificationsEnabled;
    private string? message;
    private int sendCount;

    protected override async Task OnInitializedAsync()
    {
        settings = AppSettings.Load();
        notificationsEnabled = await Notifier.AreNotificationsEnabledAsync();
    }

    private void Update(Action<AppSettings> change)
    {
        change(settings);
        AppSettings.Save(settings);
    }

    private async Task RequestPermission()
    {
        notificationsEnabled = await Notifier.RequestPermissionAsync();
    }

    private async Task SendTestNotification()
    {
        sendCount++;
        await Notifier.NotifyAsync("InCharge", $"Test notification #{sendCount} at {DateTime.Now:HH:mm:ss}");
        message = $"Test #{sendCount} sent at {DateTime.Now:HH:mm:ss}";
    }
}
