@page "/advanced"
@using InCharge.Mobile.Services
@inject NotificationService Notifier
@inject AppSettingsService AppSettings
@inject AdvancedSessionService Sessions
@inject ActivityLogService ActivityLog
@implements IAsyncDisposable

<PageTitle>Advanced Interval</PageTitle>

@if (mode == Mode.List)
{
    <h1>Advanced Interval</h1>

    <p>
        Build a custom sequence of move/rest blocks with their own durations, save it
        under a name, and run it whenever you like.
    </p>

    @if (!notificationsEnabled)
    {
        <div class="alert alert-warning">
            Notifications aren't enabled yet. Visit <a href="settings">settings</a> before starting an activity.
        </div>
    }

    <button class="btn btn-primary mb-3" @onclick="StartNewSession">
        @PlusIcon <span>New session</span>
    </button>

    @if (sessions.Count == 0)
    {
        <p class="text-muted">No saved sessions yet.</p>
    }

    @foreach (var session in sessions)
    {
        <div class="card mb-2">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <strong>@session.Name</strong>
                    <div class="small text-muted">@FormatSessionSummary(session)</div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-success btn-sm" @onclick="() => RunSession(session)" title="Start" aria-label="Start">@PlayIcon</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditSession(session)" title="Edit" aria-label="Edit">@EditIcon</button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteSession(session)" title="Delete" aria-label="Delete">@DeleteIcon</button>
                </div>
            </div>
        </div>
    }
}
else if (mode == Mode.Edit)
{
    <h1>@(editingSessionId is null ? "New session" : "Edit session")</h1>

    <div class="mb-3" style="max-width: 480px;">
        <label class="form-label" for="sessionName">Name</label>
        <input id="sessionName" class="form-control" @bind="editName" />
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Duration unit for this session</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="editUnit" id="editUnitMinutes"
                   checked="@editUseMinutes" @onchange="() => editUseMinutes = true" />
            <label class="form-check-label" for="editUnitMinutes">Minutes</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="editUnit" id="editUnitSeconds"
                   checked="@(!editUseMinutes)" @onchange="() => editUseMinutes = false" />
            <label class="form-check-label" for="editUnitSeconds">Seconds</label>
        </div>
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="editWarmupEnabled"
                   checked="@editWarmupEnabled" @onchange="e => editWarmupEnabled = (bool)(e.Value ?? false)" />
            <label class="form-check-label" for="editWarmupEnabled">Include a warm-up</label>
        </div>
        @if (editWarmupEnabled)
        {
            @if (editUseMinutes)
            {
                <div class="d-flex align-items-center gap-2 mt-2">
                    <input type="number" min="0" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                           value="@(editWarmupDurationSeconds / 60)" @onchange="e => editWarmupDurationSeconds = ParseNonNegativeInt(e.Value) * 60 + editWarmupDurationSeconds % 60" />
                    <span>min</span>
                    <input type="number" min="0" max="59" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                           value="@(editWarmupDurationSeconds % 60)" @onchange="e => editWarmupDurationSeconds = editWarmupDurationSeconds / 60 * 60 + Math.Clamp(ParseNonNegativeInt(e.Value), 0, 59)" />
                    <span>sec</span>
                </div>
            }
            else
            {
                <input type="number" min="1" step="1" inputmode="numeric" class="form-control mt-2" style="max-width: 6rem;"
                       value="@editWarmupDurationSeconds" @onchange="e => editWarmupDurationSeconds = Math.Max(1, ParseNonNegativeInt(e.Value))" />
            }
        }
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="editCooldownEnabled"
                   checked="@editCooldownEnabled" @onchange="e => editCooldownEnabled = (bool)(e.Value ?? false)" />
            <label class="form-check-label" for="editCooldownEnabled">Include a cool-down</label>
        </div>
        @if (editCooldownEnabled)
        {
            @if (editUseMinutes)
            {
                <div class="d-flex align-items-center gap-2 mt-2">
                    <input type="number" min="0" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                           value="@(editCooldownDurationSeconds / 60)" @onchange="e => editCooldownDurationSeconds = ParseNonNegativeInt(e.Value) * 60 + editCooldownDurationSeconds % 60" />
                    <span>min</span>
                    <input type="number" min="0" max="59" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                           value="@(editCooldownDurationSeconds % 60)" @onchange="e => editCooldownDurationSeconds = editCooldownDurationSeconds / 60 * 60 + Math.Clamp(ParseNonNegativeInt(e.Value), 0, 59)" />
                    <span>sec</span>
                </div>
            }
            else
            {
                <input type="number" min="1" step="1" inputmode="numeric" class="form-control mt-2" style="max-width: 6rem;"
                       value="@editCooldownDurationSeconds" @onchange="e => editCooldownDurationSeconds = Math.Max(1, ParseNonNegativeInt(e.Value))" />
            }
        }
    </div>

    @for (var gi = 0; gi < editGroups.Count; gi++)
    {
        var groupIndex = gi;
        var group = editGroups[groupIndex];
        <div class="card mb-2 border-primary-subtle">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <strong>Group @(groupIndex + 1)</strong>
                    <label class="ms-2 mb-0" for="@($"groupRepeat{groupIndex}")">Repeat</label>
                    <input id="@($"groupRepeat{groupIndex}")" type="number" min="1" step="1" inputmode="numeric" class="form-control" style="max-width: 5rem;"
                           value="@group.RepeatCount" @onchange="e => group.RepeatCount = Math.Max(1, ParseNonNegativeInt(e.Value))" />
                    <span>time(s)</span>
                    <button class="btn btn-outline-danger btn-sm ms-auto" @onclick="() => editGroups.RemoveAt(groupIndex)" title="Remove group" aria-label="Remove group">
                        @DeleteIcon
                    </button>
                </div>

                @for (var bi = 0; bi < group.Blocks.Count; bi++)
                {
                    var blockIndex = bi;
                    var block = group.Blocks[blockIndex];
                    <div class="card mb-2">
                        <div class="card-body d-flex flex-wrap align-items-center gap-2">
                            <span class="fw-bold" style="width: 1.5rem;">@(blockIndex + 1)</span>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" name="@($"blockType{groupIndex}_{blockIndex}")" id="@($"blockMove{groupIndex}_{blockIndex}")"
                                       checked="@block.IsMove" @onchange="() => block.IsMove = true" />
                                <label class="form-check-label" for="@($"blockMove{groupIndex}_{blockIndex}")">Move</label>
                            </div>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" name="@($"blockType{groupIndex}_{blockIndex}")" id="@($"blockRest{groupIndex}_{blockIndex}")"
                                       checked="@(!block.IsMove)" @onchange="() => block.IsMove = false" />
                                <label class="form-check-label" for="@($"blockRest{groupIndex}_{blockIndex}")">Rest</label>
                            </div>
                            @if (editUseMinutes)
                            {
                                <input type="number" min="0" step="1" inputmode="numeric" class="form-control" style="max-width: 5rem;"
                                       value="@(block.DurationSeconds / 60)" @onchange="e => SetBlockMinutes(block, e.Value)" />
                                <span>min</span>
                                <input type="number" min="0" max="59" step="1" inputmode="numeric" class="form-control" style="max-width: 5rem;"
                                       value="@(block.DurationSeconds % 60)" @onchange="e => SetBlockSeconds(block, e.Value)" />
                                <span>sec</span>
                            }
                            else
                            {
                                <input type="number" min="1" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                                       value="@block.DurationSeconds" @onchange="e => SetBlockWholeSeconds(block, e.Value)" />
                                <span>sec</span>
                            }
                            <button class="btn btn-outline-danger btn-sm ms-auto" @onclick="() => group.Blocks.RemoveAt(blockIndex)" title="Remove block" aria-label="Remove block">
                                @DeleteIcon
                            </button>
                        </div>
                    </div>
                }

                <button class="btn btn-outline-primary btn-sm" @onclick="() => AddBlockToGroup(group)">
                    @PlusIcon <span>Add block</span>
                </button>
            </div>
        </div>
    }

    <button class="btn btn-outline-primary mb-3" @onclick="AddGroup">
        @PlusIcon <span>Add group</span>
    </button>

    @if (!string.IsNullOrEmpty(editError))
    {
        <div class="alert alert-danger">@editError</div>
    }

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="SaveSession">Save</button>
        <button class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
    </div>
}
else if (mode == Mode.Running && runningSession is not null)
{
    <h1>@runningSession.Name</h1>

    <div class="activity-overlay">
        <div class="activity-card">
            <div class="activity-phase @PhaseColorClass">@StatusHeading</div>
            @if (!string.IsNullOrEmpty(FormattedRemaining))
            {
                <div class="activity-timer">@FormattedRemaining</div>
            }
            <div class="activity-progress">@StatusDetail</div>
            @if (isCompleted && pendingLogEntry is not null)
            {
                <div class="log-status">
                    @if (logSaved)
                    {
                        <span>✓ Saved to your activity log</span>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="SaveToLog">Save to log</button>
                    }
                </div>
            }
            <div class="activity-controls">
                @if (isRunning)
                {
                    <button class="btn btn-light btn-icon" @onclick="PauseActivity" title="Pause" aria-label="Pause">
                        @PauseIcon
                    </button>
                }
                else if (isPaused)
                {
                    <button class="btn btn-light btn-icon" @onclick="ResumeActivity" title="Resume" aria-label="Resume">
                        @PlayIcon
                    </button>
                }
                <button class="btn btn-outline-light btn-icon" @onclick="StopRun" title="Stop" aria-label="Stop">
                    @ResetIcon
                </button>
            </div>
        </div>
    </div>
}

@code {
    private enum Mode
    {
        List,
        Edit,
        Running
    }

    private Mode mode = Mode.List;
    private bool notificationsEnabled;
    private List<AdvancedSession> sessions = new();

    // Editor state
    private string? editingSessionId;
    private string editName = "";
    private bool editUseMinutes = true;
    private bool editWarmupEnabled;
    private int editWarmupDurationSeconds = 300;
    private bool editCooldownEnabled;
    private int editCooldownDurationSeconds = 300;
    private List<IntervalGroup> editGroups = new();
    private string? editError;

    // Running state
    private AdvancedSession? runningSession;
    private List<RunBlock> runBlocks = new();
    private int currentBlockIndex = -1;
    private int remainingSeconds;
    private int totalDurationSeconds;
    private bool isRunning;
    private bool isPaused;
    private bool isCompleted;
    private CancellationTokenSource? _cts;
    private readonly ActivityRecorder recorder = new();
    private ActivityLogEntry? pendingLogEntry;
    private bool logSaved;

    private void SaveToLog()
    {
        if (pendingLogEntry is not null && !logSaved)
        {
            ActivityLog.Add(pendingLogEntry);
            logSaved = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        notificationsEnabled = await Notifier.AreNotificationsEnabledAsync();
        sessions = Sessions.LoadAll();
    }

    private void StartNewSession()
    {
        editingSessionId = null;
        editName = "";
        editUseMinutes = true;
        editWarmupEnabled = false;
        editWarmupDurationSeconds = 300;
        editCooldownEnabled = false;
        editCooldownDurationSeconds = 300;
        editGroups = new List<IntervalGroup>
        {
            new() { RepeatCount = 1, Blocks = new List<IntervalBlock> { new() { IsMove = true, DurationSeconds = 60 } } }
        };
        editError = null;
        mode = Mode.Edit;
    }

    private void EditSession(AdvancedSession session)
    {
        editingSessionId = session.Id;
        editName = session.Name;
        editUseMinutes = session.UseMinutes;
        editWarmupEnabled = session.WarmupEnabled;
        editWarmupDurationSeconds = session.WarmupDurationSeconds;
        editCooldownEnabled = session.CooldownEnabled;
        editCooldownDurationSeconds = session.CooldownDurationSeconds;
        editGroups = session.Groups.Select(g => new IntervalGroup
        {
            RepeatCount = g.RepeatCount,
            Blocks = g.Blocks.Select(b => new IntervalBlock { IsMove = b.IsMove, DurationSeconds = b.DurationSeconds }).ToList()
        }).ToList();
        editError = null;
        mode = Mode.Edit;
    }

    private void AddGroup()
    {
        var lastGroup = editGroups.LastOrDefault();
        var lastBlock = lastGroup?.Blocks.LastOrDefault();
        editGroups.Add(new IntervalGroup
        {
            RepeatCount = 1,
            Blocks = new List<IntervalBlock> { new() { IsMove = lastBlock is null || !lastBlock.IsMove, DurationSeconds = lastBlock?.DurationSeconds ?? 60 } }
        });
    }

    private void AddBlockToGroup(IntervalGroup group)
    {
        var last = group.Blocks.LastOrDefault();
        group.Blocks.Add(new IntervalBlock { IsMove = last is null || !last.IsMove, DurationSeconds = last?.DurationSeconds ?? 60 });
    }

    private static void SetBlockMinutes(IntervalBlock block, object? value)
    {
        var minutes = ParseNonNegativeInt(value);
        block.DurationSeconds = minutes * 60 + block.DurationSeconds % 60;
    }

    private static void SetBlockSeconds(IntervalBlock block, object? value)
    {
        var seconds = Math.Clamp(ParseNonNegativeInt(value), 0, 59);
        block.DurationSeconds = block.DurationSeconds / 60 * 60 + seconds;
    }

    private static void SetBlockWholeSeconds(IntervalBlock block, object? value)
    {
        block.DurationSeconds = Math.Max(1, ParseNonNegativeInt(value));
    }

    private static int ParseNonNegativeInt(object? value) =>
        int.TryParse(value?.ToString(), out var parsed) ? Math.Max(0, parsed) : 0;

    private void SaveSession()
    {
        if (string.IsNullOrWhiteSpace(editName))
        {
            editError = "Give this session a name.";
            return;
        }

        if (editGroups.Count == 0 || editGroups.All(g => g.Blocks.Count == 0))
        {
            editError = "Add at least one block.";
            return;
        }

        if (editGroups.SelectMany(g => g.Blocks).Any(b => b.DurationSeconds <= 0))
        {
            editError = "Every block needs a duration of at least 1 second.";
            return;
        }

        if (editWarmupEnabled && editWarmupDurationSeconds <= 0)
        {
            editError = "The warm-up needs a duration of at least 1 second.";
            return;
        }

        if (editCooldownEnabled && editCooldownDurationSeconds <= 0)
        {
            editError = "The cool-down needs a duration of at least 1 second.";
            return;
        }

        var session = editingSessionId is null
            ? new AdvancedSession()
            : sessions.First(s => s.Id == editingSessionId);

        session.Name = editName.Trim();
        session.UseMinutes = editUseMinutes;
        session.WarmupEnabled = editWarmupEnabled;
        session.WarmupDurationSeconds = editWarmupDurationSeconds;
        session.CooldownEnabled = editCooldownEnabled;
        session.CooldownDurationSeconds = editCooldownDurationSeconds;
        session.Groups = editGroups.Where(g => g.Blocks.Count > 0).ToList();

        if (editingSessionId is null)
        {
            sessions.Add(session);
        }

        Sessions.SaveAll(sessions);
        editError = null;
        mode = Mode.List;
    }

    private void CancelEdit()
    {
        editError = null;
        mode = Mode.List;
    }

    private void DeleteSession(AdvancedSession session)
    {
        sessions.Remove(session);
        Sessions.SaveAll(sessions);
    }

    private string FormatSessionSummary(AdvancedSession session)
    {
        var runBlocks = BuildRunBlocks(session);
        var blockInstances = runBlocks.Count(b => b.Kind is BlockKind.Move or BlockKind.Rest);
        var groupWord = session.Groups.Count == 1 ? "group" : "groups";
        var blockWord = blockInstances == 1 ? "block" : "blocks";
        return $"{session.Groups.Count} {groupWord} · {blockInstances} {blockWord} · {FormatSeconds(runBlocks.Sum(b => b.DurationSeconds))}";
    }

    // Expands warm-up, every group's repeats and cool-down into a flat run sequence, so the
    // timer loop below only ever has to deal with "the next block", never with groups/repeats.
    private static List<RunBlock> BuildRunBlocks(AdvancedSession session)
    {
        var list = new List<RunBlock>();
        if (session.WarmupEnabled && session.WarmupDurationSeconds > 0)
        {
            list.Add(new RunBlock(BlockKind.Warmup, session.WarmupDurationSeconds, "Warm-up"));
        }

        var groupCount = session.Groups.Count;
        for (var g = 0; g < groupCount; g++)
        {
            var group = session.Groups[g];
            var repeatCount = Math.Max(1, group.RepeatCount);
            for (var r = 1; r <= repeatCount; r++)
            {
                var groupLabel = groupCount > 1 ? $"Group {g + 1}/{groupCount}" : null;
                var repeatLabel = repeatCount > 1 ? $"Rep {r}/{repeatCount}" : null;
                for (var b = 0; b < group.Blocks.Count; b++)
                {
                    var block = group.Blocks[b];
                    var blockLabel = group.Blocks.Count > 1 ? $"Block {b + 1}/{group.Blocks.Count}" : null;
                    var detail = string.Join(" · ", new[] { groupLabel, repeatLabel, blockLabel }.Where(s => !string.IsNullOrEmpty(s)));
                    list.Add(new RunBlock(block.IsMove ? BlockKind.Move : BlockKind.Rest, Math.Max(1, block.DurationSeconds), detail));
                }
            }
        }

        var hasCooldown = session.CooldownEnabled && session.CooldownDurationSeconds > 0;
        // The cool-down already brings things back down, so a trailing rest right
        // before it would just be a second cool-down.
        if (hasCooldown && list.Count > 0 && list[^1].Kind == BlockKind.Rest)
        {
            list.RemoveAt(list.Count - 1);
        }
        if (hasCooldown)
        {
            list.Add(new RunBlock(BlockKind.Cooldown, session.CooldownDurationSeconds, "Cool-down"));
        }

        return list;
    }

    private async Task RunSession(AdvancedSession session)
    {
        runningSession = session;
        runBlocks = BuildRunBlocks(session);
        currentBlockIndex = -1;
        isCompleted = false;
        isRunning = true;
        isPaused = false;
        totalDurationSeconds = runBlocks.Sum(b => b.DurationSeconds);
        mode = Mode.Running;
        recorder.Start();
        pendingLogEntry = null;
        await AdvanceBlockAsync();
        RunLoop();
    }

    private void PauseActivity()
    {
        _cts?.Cancel();
        isRunning = false;
        isPaused = true;
        recorder.Pause();
        if (currentBlockIndex >= 0 && currentBlockIndex < runBlocks.Count)
        {
            var block = runBlocks[currentBlockIndex];
            _ = Notifier.ShowPausedAsync(HeadingFor(block.Kind), remainingSeconds, block.DurationSeconds);
        }
    }

    private async Task ResumeActivity()
    {
        isPaused = false;
        isRunning = true;
        recorder.Resume();
        if (currentBlockIndex >= 0 && currentBlockIndex < runBlocks.Count)
        {
            await UpdateProgressAsync();
        }
        RunLoop();
    }

    private void StopRun()
    {
        _cts?.Cancel();
        mode = Mode.List;
        runningSession = null;
        runBlocks = new List<RunBlock>();
        isRunning = false;
        isPaused = false;
        isCompleted = false;
        _ = Notifier.ClearTimerAsync();
    }

    private void RunLoop()
    {
        _cts = new CancellationTokenSource();
        _ = RunTimerLoopAsync(_cts.Token);
    }

    private async Task RunTimerLoopAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(token))
            {
                remainingSeconds--;
                if (remainingSeconds <= 0)
                {
                    await AdvanceBlockAsync();
                }
                else
                {
                    await UpdateProgressAsync();
                }
                await InvokeAsync(StateHasChanged);
                if (isCompleted)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the activity is paused or stopped.
        }
    }

    private async Task AdvanceBlockAsync()
    {
        currentBlockIndex++;
        if (currentBlockIndex >= runBlocks.Count)
        {
            isCompleted = true;
            isRunning = false;
            pendingLogEntry = recorder.Complete(runningSession?.Name ?? "Advanced Interval", true, runBlocks.Select(b => (b.Kind.ToString(), b.DurationSeconds)));
            logSaved = false;
            if (AppSettings.Load().AutoSaveToLog)
            {
                SaveToLog();
            }
            await Notifier.ClearTimerAsync();
            await Notifier.NotifyAsync("InCharge", "Activity complete. Great job!");
            return;
        }

        var block = runBlocks[currentBlockIndex];
        remainingSeconds = block.DurationSeconds;
        await Notifier.StartPhaseAsync(HeadingFor(block.Kind), block.Detail, remainingSeconds, block.DurationSeconds);
    }

    private Task UpdateProgressAsync()
    {
        var block = runBlocks[currentBlockIndex];
        return Notifier.UpdateTimerAsync(HeadingFor(block.Kind), block.Detail, remainingSeconds, block.DurationSeconds);
    }

    private RenderFragment PlayIcon => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 2.5v11l10-5.5-10-5.5z" /></svg>;

    private RenderFragment PauseIcon => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 2.5h3v11H4v-11zm5 0h3v11H9v-11z" /></svg>;

    private RenderFragment ResetIcon => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" /><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" /></svg>;

