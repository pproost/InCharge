    private static string HeadingFor(BlockKind kind) => kind switch
    {
        BlockKind.Warmup => "Warm-up!",
        BlockKind.Move => "Move!",
        BlockKind.Rest => "Rest",
        BlockKind.Cooldown => "Cool down!",
        _ => ""
    };

    private static string ColorClassFor(BlockKind kind) => kind switch
    {
        BlockKind.Warmup => "phase-warmup",
        BlockKind.Move => "phase-move",
        BlockKind.Rest => "phase-rest",
        BlockKind.Cooldown => "phase-cooldown",
        _ => ""
    };

    private string PhaseColorClass => isCompleted
        ? "phase-complete"
        : isPaused
            ? "phase-paused"
            : currentBlockIndex >= 0 && currentBlockIndex < runBlocks.Count
                ? ColorClassFor(runBlocks[currentBlockIndex].Kind)
                : "";

    private string FormattedRemaining => isCompleted
        ? (AppSettings.Load().ShowDurationOnComplete ? FormatSeconds(totalDurationSeconds) : string.Empty)
        : FormatSeconds(Math.Max(0, remainingSeconds));

    private static string FormatSeconds(int seconds) => TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");

    private string StatusHeading => isCompleted
        ? "Activity complete"
        : isPaused
            ? "Paused"
            : currentBlockIndex >= 0 && currentBlockIndex < runBlocks.Count
                ? HeadingFor(runBlocks[currentBlockIndex].Kind)
                : "Idle";

    private string StatusDetail
    {
        get
        {
            if (isCompleted)
            {
                return "You finished the activity.";
            }

            if (currentBlockIndex < 0 || currentBlockIndex >= runBlocks.Count)
            {
                return string.Empty;
            }

            return runBlocks[currentBlockIndex].Detail;
        }
    }

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        if (mode == Mode.Running && !isCompleted)
        {
            _ = Notifier.ClearTimerAsync();
        }
        return ValueTask.CompletedTask;
    }

    private enum BlockKind
    {
        Warmup,
        Move,
        Rest,
        Cooldown
    }

    private record RunBlock(BlockKind Kind, int DurationSeconds, string Detail);
}
