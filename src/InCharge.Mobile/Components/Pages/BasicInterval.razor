@page "/"
@using System.Text.Json
@using InCharge.Mobile.Services
@inject NotificationService Notifier
@inject AppSettingsService AppSettings
@inject ActivityLogService ActivityLog
@implements IAsyncDisposable

<PageTitle>Basic Interval</PageTitle>

<h1>Basic Interval</h1>

<p>
    Set up a simple move/rest interval activity. While it's running, InCharge sends a
    notification at the start of every phase so you know when to speed up or slow down
    without having to look at your phone.
</p>

@if (!notificationsEnabled)
{
    <div class="alert alert-warning">
        Notifications aren't enabled yet. Visit <a href="settings">settings</a> before starting an activity.
    </div>
}

<div class="row g-3" style="max-width: 480px;">
    <div class="col-12">
        <label class="form-label d-block">Duration unit</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="unit" id="unitMinutes"
                   checked="@UseMinutes" disabled="@IsConfigLocked" @onchange="() => SetUnitAsync(true)" />
            <label class="form-check-label" for="unitMinutes">Minutes</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="unit" id="unitSeconds"
                   checked="@(!UseMinutes)" disabled="@IsConfigLocked" @onchange="() => SetUnitAsync(false)" />
            <label class="form-check-label" for="unitSeconds">Seconds</label>
        </div>
    </div>
    <div class="col-12">
        <label class="form-label">Moving duration</label>
        @if (UseMinutes)
        {
            <div class="d-flex align-items-center gap-2">
                <input type="number" min="0" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                       @bind="MovingMinutesPart" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
                <span>min</span>
                <input type="number" min="0" max="59" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                       @bind="MovingSecondsPart" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
                <span>sec</span>
            </div>
        }
        else
        {
            <input type="number" min="1" step="1" inputmode="numeric" class="form-control"
                   @bind="MovingDurationSeconds" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
        }
    </div>
    <div class="col-12">
        <label class="form-label">Resting duration</label>
        @if (UseMinutes)
        {
            <div class="d-flex align-items-center gap-2">
                <input type="number" min="0" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                       @bind="RestingMinutesPart" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
                <span>min</span>
                <input type="number" min="0" max="59" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                       @bind="RestingSecondsPart" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
                <span>sec</span>
            </div>
        }
        else
        {
            <input type="number" min="1" step="1" inputmode="numeric" class="form-control"
                   @bind="RestingDurationSeconds" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
        }
    </div>
    <div class="col-12">
        <label class="form-label" for="repeats">Number of repeats</label>
        <input id="repeats" type="number" min="1" step="1" inputmode="numeric" class="form-control"
               @bind="Repeats" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="warmupEnabled"
                   checked="@WarmupEnabled" disabled="@IsConfigLocked" @onchange="e => SetWarmupEnabledAsync((bool)(e.Value ?? false))" />
            <label class="form-check-label" for="warmupEnabled">Include a warm-up</label>
        </div>
        @if (WarmupEnabled)
        {
            @if (UseMinutes)
            {
                <div class="d-flex align-items-center gap-2 mt-2">
                    <input type="number" min="0" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                           @bind="WarmupMinutesPart" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
                    <span>min</span>
                    <input type="number" min="0" max="59" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                           @bind="WarmupSecondsPart" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
                    <span>sec</span>
                </div>
            }
            else
            {
                <input type="number" min="1" step="1" inputmode="numeric" class="form-control mt-2"
                       @bind="WarmupDurationSeconds" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
            }
        }
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="cooldownEnabled"
                   checked="@CooldownEnabled" disabled="@IsConfigLocked" @onchange="e => SetCooldownEnabledAsync((bool)(e.Value ?? false))" />
            <label class="form-check-label" for="cooldownEnabled">Include a cool-down</label>
        </div>
        @if (CooldownEnabled)
        {
            @if (UseMinutes)
            {
                <div class="d-flex align-items-center gap-2 mt-2">
                    <input type="number" min="0" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                           @bind="CooldownMinutesPart" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
                    <span>min</span>
                    <input type="number" min="0" max="59" step="1" inputmode="numeric" class="form-control" style="max-width: 6rem;"
                           @bind="CooldownSecondsPart" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
                    <span>sec</span>
                </div>
            }
            else
            {
                <input type="number" min="1" step="1" inputmode="numeric" class="form-control mt-2"
                       @bind="CooldownDurationSeconds" @bind:after="SaveSettingsAsync" disabled="@IsConfigLocked" />
            }
        }
    </div>
</div>

@if (!HasStarted)
{
    <div class="mt-4">
        <button class="btn btn-primary" @onclick="StartActivity" title="Start activity" aria-label="Start activity">
            @PlayIcon <span>Start activity</span>
        </button>
    </div>
}

@if (HasStarted)
{
    <div class="activity-overlay">
        <div class="activity-card">
            <div class="activity-phase @PhaseColorClass">@StatusHeading</div>
            @if (!string.IsNullOrEmpty(FormattedRemaining))
            {
                <div class="activity-timer">@FormattedRemaining</div>
            }
            <div class="activity-progress">@StatusDetail</div>
            @if (isCompleted && pendingLogEntry is not null)
            {
                <div class="log-status">
                    @if (logSaved)
                    {
                        <span>✓ Saved to your activity log</span>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="SaveToLog">Save to log</button>
                    }
                </div>
            }
            <div class="activity-controls">
                @if (isRunning)
                {
                    <button class="btn btn-light btn-icon" @onclick="PauseActivity" title="Pause" aria-label="Pause">
                        @PauseIcon
                    </button>
                }
                else if (isPaused)
                {
                    <button class="btn btn-light btn-icon" @onclick="StartActivity" title="Resume" aria-label="Resume">
                        @PlayIcon
                    </button>
                }
                <button class="btn btn-outline-light btn-icon" @onclick="ResetActivity" title="Reset activity" aria-label="Reset activity">
                    @ResetIcon
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string StorageKey = "incharge.basicInterval.settings";

    private bool notificationsEnabled;

    private int MovingDurationSeconds { get; set; } = 60;
    private int RestingDurationSeconds { get; set; } = 60;
    private int Repeats { get; set; } = 4;
    private bool UseMinutes { get; set; } = true;
    private bool WarmupEnabled { get; set; }
    private int WarmupDurationSeconds { get; set; } = 300;
    private bool CooldownEnabled { get; set; }
    private int CooldownDurationSeconds { get; set; } = 300;

    private int MovingMinutesPart
    {
        get => MovingDurationSeconds / 60;
        set => MovingDurationSeconds = value * 60 + MovingDurationSeconds % 60;
    }

    private int MovingSecondsPart
    {
        get => MovingDurationSeconds % 60;
        set => MovingDurationSeconds = MovingDurationSeconds / 60 * 60 + Math.Clamp(value, 0, 59);
    }

    private int RestingMinutesPart
    {
        get => RestingDurationSeconds / 60;
        set => RestingDurationSeconds = value * 60 + RestingDurationSeconds % 60;
    }

    private int RestingSecondsPart
    {
        get => RestingDurationSeconds % 60;
        set => RestingDurationSeconds = RestingDurationSeconds / 60 * 60 + Math.Clamp(value, 0, 59);
    }

    private int WarmupMinutesPart
    {
        get => WarmupDurationSeconds / 60;
        set => WarmupDurationSeconds = value * 60 + WarmupDurationSeconds % 60;
    }

    private int WarmupSecondsPart
    {
        get => WarmupDurationSeconds % 60;
        set => WarmupDurationSeconds = WarmupDurationSeconds / 60 * 60 + Math.Clamp(value, 0, 59);
    }

    private int CooldownMinutesPart
    {
        get => CooldownDurationSeconds / 60;
        set => CooldownDurationSeconds = value * 60 + CooldownDurationSeconds % 60;
    }

    private int CooldownSecondsPart
    {
        get => CooldownDurationSeconds % 60;
        set => CooldownDurationSeconds = CooldownDurationSeconds / 60 * 60 + Math.Clamp(value, 0, 59);
    }

    private List<Phase> phases = new();
    private int totalDurationSeconds;
    private int currentPhaseIndex = -1;
    private int remainingSeconds;
    private bool isRunning;
    private bool isPaused;
    private bool isCompleted;
    private CancellationTokenSource? _cts;
    private readonly ActivityRecorder recorder = new();
    private ActivityLogEntry? pendingLogEntry;
    private bool logSaved;

    private void SaveToLog()
    {
        if (pendingLogEntry is not null && !logSaved)
        {
            ActivityLog.Add(pendingLogEntry);
            logSaved = true;
        }
    }

    private bool HasStarted => currentPhaseIndex >= 0;
    private bool IsConfigLocked => HasStarted;

    protected override async Task OnInitializedAsync()
    {
        notificationsEnabled = await Notifier.AreNotificationsEnabledAsync();
        LoadSettings();
    }

    private void LoadSettings()
    {
        var json = Preferences.Default.Get(StorageKey, string.Empty);
        if (string.IsNullOrEmpty(json))
        {
            return;
        }

        try
        {
            var saved = JsonSerializer.Deserialize<IntervalSettings>(json);
            if (saved is not null)
            {
                MovingDurationSeconds = saved.MovingDurationSeconds;
                RestingDurationSeconds = saved.RestingDurationSeconds;
                Repeats = saved.Repeats;
                UseMinutes = saved.UseMinutes;
                WarmupEnabled = saved.WarmupEnabled;
                WarmupDurationSeconds = saved.WarmupDurationSeconds;
                CooldownEnabled = saved.CooldownEnabled;
                CooldownDurationSeconds = saved.CooldownDurationSeconds;
            }
        }
        catch (JsonException)
        {
            // Ignore corrupt or outdated saved settings and keep the defaults.
        }
    }

    private Task SaveSettingsAsync()
    {
        var settings = new IntervalSettings
        {
            MovingDurationSeconds = MovingDurationSeconds,
            RestingDurationSeconds = RestingDurationSeconds,
            Repeats = Repeats,
            UseMinutes = UseMinutes,
            WarmupEnabled = WarmupEnabled,
            WarmupDurationSeconds = WarmupDurationSeconds,
            CooldownEnabled = CooldownEnabled,
            CooldownDurationSeconds = CooldownDurationSeconds
        };
        Preferences.Default.Set(StorageKey, JsonSerializer.Serialize(settings));
        return Task.CompletedTask;
    }

    private Task SetUnitAsync(bool useMinutes)
    {
        UseMinutes = useMinutes;
        return SaveSettingsAsync();
    }

    private Task SetWarmupEnabledAsync(bool enabled)
    {
        WarmupEnabled = enabled;
        return SaveSettingsAsync();
    }

    private Task SetCooldownEnabledAsync(bool enabled)
    {
        CooldownEnabled = enabled;
        return SaveSettingsAsync();
    }

    private List<Phase> BuildPhases()
    {
        var repeats = Math.Max(1, Repeats);
        var moveSeconds = Math.Max(1, MovingDurationSeconds);
        var restSeconds = Math.Max(1, RestingDurationSeconds);
        var list = new List<Phase>();
        if (WarmupEnabled && WarmupDurationSeconds > 0)
        {
            list.Add(new Phase(PhaseType.Warmup, 0, WarmupDurationSeconds));
        }
        for (var i = 1; i <= repeats; i++)
        {
            list.Add(new Phase(PhaseType.Move, i, moveSeconds));
            list.Add(new Phase(PhaseType.Rest, i, restSeconds));
        }

        var hasCooldown = CooldownEnabled && CooldownDurationSeconds > 0;
        // The cool-down already brings things back down, so a trailing rest right
        // before it would just be a second cool-down.
        if (hasCooldown && list.Count > 0 && list[^1].Type == PhaseType.Rest)
        {
            list.RemoveAt(list.Count - 1);
        }
        if (hasCooldown)
        {
            list.Add(new Phase(PhaseType.Cooldown, 0, CooldownDurationSeconds));
        }
        return list;
    }

    private async Task StartActivity()
    {
        if (isPaused)
        {
            isPaused = false;
            isRunning = true;
            recorder.Resume();
            if (currentPhaseIndex >= 0 && currentPhaseIndex < phases.Count)
            {
                await UpdateProgressAsync();
            }
            RunLoop();
            return;
        }

        await SaveSettingsAsync();
        phases = BuildPhases();
        totalDurationSeconds = phases.Sum(p => p.DurationSeconds);
        currentPhaseIndex = -1;
        isCompleted = false;
        isRunning = true;
        recorder.Start();
        pendingLogEntry = null;
        await AdvancePhaseAsync();
        RunLoop();
    }

    private void PauseActivity()
    {
        _cts?.Cancel();
        isRunning = false;
        isPaused = true;
        recorder.Pause();
        if (currentPhaseIndex >= 0 && currentPhaseIndex < phases.Count)
        {
            var phase = phases[currentPhaseIndex];
            _ = Notifier.ShowPausedAsync(HeadingFor(phase.Type), remainingSeconds, phase.DurationSeconds);
        }
    }

    private void ResetActivity()
    {
        _cts?.Cancel();
        phases = new List<Phase>();
        currentPhaseIndex = -1;
        remainingSeconds = 0;
        isRunning = false;
        isPaused = false;
        isCompleted = false;
        _ = Notifier.ClearTimerAsync();
    }

    private void RunLoop()
    {
        _cts = new CancellationTokenSource();
        _ = RunTimerLoopAsync(_cts.Token);
    }

    private async Task RunTimerLoopAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(token))
            {
                remainingSeconds--;
                if (remainingSeconds <= 0)
                {
                    await AdvancePhaseAsync();
                }
                else
                {
                    await UpdateProgressAsync();
                }
                await InvokeAsync(StateHasChanged);
                if (isCompleted)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the activity is paused or reset.
        }
    }

    private async Task AdvancePhaseAsync()
    {
        currentPhaseIndex++;
        if (currentPhaseIndex >= phases.Count)
        {
            isCompleted = true;
            isRunning = false;
            pendingLogEntry = recorder.Complete("Basic Interval", false, phases.Select(p => (p.Type.ToString(), p.DurationSeconds)));
            logSaved = false;
            if (AppSettings.Load().AutoSaveToLog)
            {
                SaveToLog();
            }
            await Notifier.ClearTimerAsync();
            await Notifier.NotifyAsync("InCharge", "Activity complete. Great job!");
            return;
        }

        var phase = phases[currentPhaseIndex];
        remainingSeconds = phase.DurationSeconds;
        await Notifier.StartPhaseAsync(HeadingFor(phase.Type), StatusDetailFor(phase), remainingSeconds, phase.DurationSeconds);
    }

    private Task UpdateProgressAsync()
    {
        var phase = phases[currentPhaseIndex];
        return Notifier.UpdateTimerAsync(HeadingFor(phase.Type), StatusDetailFor(phase), remainingSeconds, phase.DurationSeconds);
    }

    private RenderFragment PlayIcon => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 2.5v11l10-5.5-10-5.5z" /></svg>;

    private RenderFragment PauseIcon => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 2.5h3v11H4v-11zm5 0h3v11H9v-11z" /></svg>;

    private RenderFragment ResetIcon => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" /><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" /></svg>;

    private static string HeadingFor(PhaseType type) => type switch
    {
        PhaseType.Warmup => "Warm-up!",
        PhaseType.Move => "Move!",
        PhaseType.Rest => "Rest",
        PhaseType.Cooldown => "Cool down!",
        _ => ""
    };

    private static string ColorClassFor(PhaseType type) => type switch
    {
        PhaseType.Warmup => "phase-warmup",
        PhaseType.Move => "phase-move",
        PhaseType.Rest => "phase-rest",
        PhaseType.Cooldown => "phase-cooldown",
        _ => ""
    };

    private string StatusDetailFor(Phase phase) => phase.Type switch
    {
        PhaseType.Warmup => "Warm-up",
        PhaseType.Cooldown => "Cool-down",
        _ => $"Repeat {phase.RepeatNumber} / {Repeats}"
    };

    private string PhaseColorClass => isCompleted
        ? "phase-complete"
        : isPaused
            ? "phase-paused"
            : currentPhaseIndex >= 0 && currentPhaseIndex < phases.Count
                ? ColorClassFor(phases[currentPhaseIndex].Type)
                : "";

    private string FormattedRemaining => isCompleted
        ? (AppSettings.Load().ShowDurationOnComplete ? FormatSeconds(totalDurationSeconds) : string.Empty)
        : FormatSeconds(Math.Max(0, remainingSeconds));

    private static string FormatSeconds(int seconds) => TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");

    private string StatusHeading => isCompleted
        ? "Activity complete"
        : isPaused
            ? "Paused"
            : currentPhaseIndex >= 0 && currentPhaseIndex < phases.Count
                ? HeadingFor(phases[currentPhaseIndex].Type)
                : "Idle";

    private string StatusDetail
    {
        get
        {
            if (isCompleted)
            {
                return "You finished the activity.";
            }

            if (currentPhaseIndex < 0 || currentPhaseIndex >= phases.Count)
            {
                return string.Empty;
            }

            return StatusDetailFor(phases[currentPhaseIndex]);
        }
    }

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        if (HasStarted && !isCompleted)
        {
            _ = Notifier.ClearTimerAsync();
        }
        return ValueTask.CompletedTask;
    }

    private enum PhaseType
    {
        Warmup,
        Move,
        Rest,
        Cooldown
    }

    private record Phase(PhaseType Type, int RepeatNumber, int DurationSeconds);

    private class IntervalSettings
    {
        public int MovingDurationSeconds { get; set; }
        public int RestingDurationSeconds { get; set; }
        public int Repeats { get; set; }
        public bool UseMinutes { get; set; }
        public bool WarmupEnabled { get; set; }
        public int WarmupDurationSeconds { get; set; } = 300;
        public bool CooldownEnabled { get; set; }
        public int CooldownDurationSeconds { get; set; } = 300;
    }
}
