@page "/settings/notifications"
@using InCharge.Mobile.Services
@inject NotificationService Notifier

<PageTitle>Notification settings</PageTitle>

<h1>Notification settings</h1>

<div class="card mb-4">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="text-uppercase small text-muted">Notification permission</div>
            <div class="fs-3 fw-bold @(notificationsEnabled ? "text-success" : "text-danger")">
                @(notificationsEnabled ? "Enabled" : "Disabled")
            </div>
        </div>
        @if (!notificationsEnabled)
        {
            <button class="btn btn-primary btn-lg" @onclick="RequestPermission">
                Enable notifications
            </button>
        }
        else
        {
            <button class="btn btn-success btn-lg" @onclick="SendTestNotification">
                Send test notification
            </button>
        }
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="card-footer">@message</div>
    }
</div>

<p>
    InCharge needs permission to show notifications so it can send you cues during an
    activity (e.g. through a paired smartwatch such as a Fitbit). If the button above
    doesn't turn notifications on, allow them manually via Android Settings &rarr; Apps
    &rarr; InCharge &rarr; Notifications.
</p>

@code {
    private bool notificationsEnabled;
    private string? message;
    private int sendCount;

    protected override async Task OnInitializedAsync()
    {
        notificationsEnabled = await Notifier.AreNotificationsEnabledAsync();
    }

    private async Task RequestPermission()
    {
        notificationsEnabled = await Notifier.RequestPermissionAsync();
    }

    private async Task SendTestNotification()
    {
        sendCount++;
        await Notifier.NotifyAsync("InCharge", $"Test notification #{sendCount} at {DateTime.Now:HH:mm:ss}");
        message = $"Notification #{sendCount} sent at {DateTime.Now:HH:mm:ss}";
    }
}
